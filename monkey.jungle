# Minimal jungle to reference manifest and project paths
# Refer to manifest and default source/resources
project.manifest = manifest.xml

# Set base paths
base.sourcePath = source
base.resourcePath = resources

# Default (committed) build strips the simulator-only fake-data path, so
# SimConfig.enabled() is false. The gitignored monkey.sim.jungle excludes
# :notsimdata instead to turn it on for the simulator. See README.
base.excludeAnnotations = simdata
